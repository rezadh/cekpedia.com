<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" android:layout_width="match_parent" android:layout_height="match_parent" android:fillViewport="true" android:background="@color/canvas">
 <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical">
  <FrameLayout android:layout_width="match_parent" android:layout_height="340dp">
   <ImageView android:layout_width="match_parent" android:layout_height="match_parent" android:src="@drawable/transtudiobandung" android:scaleType="centerCrop" android:contentDescription="Destinasi wisata lokal"/>
   <View android:layout_width="match_parent" android:layout_height="match_parent" android:background="@drawable/bg_hero_overlay"/>
   <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:padding="28dp">
    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="cekpedia" android:textSize="29sp" android:textColor="@color/surface" android:fontFamily="sans-serif" android:textStyle="bold"/>
    <View android:layout_width="1dp" android:layout_height="0dp" android:layout_weight="1"/>
    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Setiap tempat&#10;punya cerita." android:textSize="36sp" android:textColor="@color/surface" android:fontFamily="sans-serif" android:textStyle="bold"/>
    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Temukan ceritamu berikutnya." android:textSize="14sp" android:textColor="@color/surface" android:fontFamily="sans-serif" android:layout_marginTop="12dp"/>
   </LinearLayout>
  </FrameLayout>
  <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:padding="28dp" android:orientation="vertical">
   <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="SELAMAT DATANG DI CEKPEDIA" android:textSize="10sp" android:textColor="@color/colorPrimary" android:fontFamily="sans-serif" android:textStyle="bold" android:letterSpacing="0.16" />
   <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Jelajah lebih dekat.&#10;Kenangan lebih banyak." android:textSize="27sp" android:textColor="@color/ink" android:fontFamily="sans-serif" android:textStyle="bold" android:layout_marginTop="14dp"/>
   <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Dari tempat makan sampai tujuan akhir pekan. Semua kebutuhan perjalananmu, dalam satu ruang." android:textSize="15sp" android:textColor="@color/muted" android:fontFamily="sans-serif" android:lineSpacingExtra="5dp" android:layout_marginTop="14dp"/>
   <FrameLayout android:layout_width="match_parent" android:layout_height="64dp" android:background="@drawable/bg_card" android:padding="5dp" android:layout_marginTop="26dp">
    <com.google.android.gms.common.SignInButton android:id="@+id/bn_login" android:layout_width="match_parent" android:layout_height="match_parent" app:buttonSize="wide" app:colorScheme="light"/>
   </FrameLayout>
   <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Masuk untuk menyimpan tempat favoritmu." android:textSize="12sp" android:textColor="@color/muted" android:fontFamily="sans-serif" android:gravity="center" android:layout_marginTop="16dp" android:layout_marginBottom="16dp"/>
  </LinearLayout>
 </LinearLayout>
</ScrollView>
