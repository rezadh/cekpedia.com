<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:background="@color/canvas">
 <ScrollView android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:fillViewport="false">
  <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical">
   <FrameLayout android:layout_width="match_parent" android:layout_height="260dp">
    <ImageView android:id="@+id/gambarmenu" android:layout_width="match_parent" android:layout_height="match_parent" android:scaleType="centerCrop" android:background="@color/mint" android:contentDescription="Foto tempat"/>
    <ImageButton android:id="@+id/detail_back" android:layout_width="48dp" android:layout_height="48dp" android:layout_margin="20dp" android:padding="14dp" android:background="@drawable/bg_badge" android:src="@drawable/ic_ui_back" android:contentDescription="Kembali" android:onClick="closeDetail"/>
    <ImageView android:id="@+id/imgfav" android:layout_width="48dp" android:layout_height="48dp" android:layout_gravity="top|right" android:layout_margin="20dp" android:padding="14dp" android:background="@drawable/bg_badge" android:src="@drawable/ic_ui_heart" android:contentDescription="Simpan ke favorit"/>
   </FrameLayout>
   <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="24dp">
    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="TEMUKAN CERITA BARUMU" android:textSize="10sp" android:textColor="@color/colorPrimary" android:fontFamily="sans-serif" android:textStyle="bold" android:letterSpacing="0.16" />
    <TextView android:id="@+id/tvjudul" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Detail tempat" android:textSize="30sp" android:textColor="@color/ink" android:fontFamily="sans-serif-medium" android:layout_marginTop="12dp"/>
    <TextView android:id="@+id/tvalamat" android:layout_width="match_parent" android:layout_height="wrap_content" android:textSize="14sp" android:textColor="@color/muted" android:lineSpacingExtra="4dp" android:layout_marginTop="10dp"/>
    <TextView android:id="@+id/tvphonenumber" android:layout_width="match_parent" android:layout_height="wrap_content" android:textSize="13sp" android:textColor="@color/colorPrimary" android:layout_marginTop="8dp"/>
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:layout_marginTop="24dp" android:layout_marginBottom="28dp"><LinearLayout android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:gravity="center" android:orientation="vertical"><ImageButton android:id="@+id/imageButtonInfo" android:layout_width="54dp" android:layout_height="54dp" android:background="@drawable/bg_mint" android:padding="16dp" android:src="@drawable/ic_ui_info" android:contentDescription="Info"/><TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Info" android:textSize="11sp" android:textColor="@color/ink" android:fontFamily="sans-serif" android:gravity="center" android:layout_marginTop="8dp"/></LinearLayout><LinearLayout android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:gravity="center" android:orientation="vertical"><ImageButton android:id="@+id/imageButtonTelp" android:layout_width="54dp" android:layout_height="54dp" android:background="@drawable/bg_mint" android:padding="16dp" android:src="@drawable/ic_ui_phone" android:contentDescription="Telepon"/><TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Telepon" android:textSize="11sp" android:textColor="@color/ink" android:fontFamily="sans-serif" android:gravity="center" android:layout_marginTop="8dp"/></LinearLayout><LinearLayout android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:gravity="center" android:orientation="vertical"><ImageButton android:id="@+id/imageButtonPos" android:layout_width="54dp" android:layout_height="54dp" android:background="@drawable/bg_mint" android:padding="16dp" android:src="@drawable/ic_ui_pin" android:contentDescription="Lokasi"/><TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Lokasi" android:textSize="11sp" android:textColor="@color/ink" android:fontFamily="sans-serif" android:gravity="center" android:layout_marginTop="8dp"/></LinearLayout><LinearLayout android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:gravity="center" android:orientation="vertical"><ImageButton android:id="@+id/imageButtonSent" android:layout_width="54dp" android:layout_height="54dp" android:background="@drawable/bg_mint" android:padding="16dp" android:src="@drawable/ic_ui_share" android:contentDescription="Bagikan"/><TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Bagikan" android:textSize="11sp" android:textColor="@color/ink" android:fontFamily="sans-serif" android:gravity="center" android:layout_marginTop="8dp"/></LinearLayout></LinearLayout>
    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Temukan di peta" android:textSize="20sp" android:textColor="@color/ink" android:fontFamily="sans-serif" android:textStyle="bold"/><TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Kenali lokasinya sebelum berangkat." android:textSize="13sp" android:textColor="@color/muted" android:fontFamily="sans-serif" android:layout_marginTop="6dp" android:layout_marginBottom="14dp"/>
    <android.support.v7.widget.CardView android:layout_width="match_parent" android:layout_height="210dp" app:cardCornerRadius="20dp" app:cardElevation="0dp" app:cardBackgroundColor="@color/mint">
     <fragment android:id="@+id/map" android:name="com.google.android.gms.maps.SupportMapFragment" android:layout_width="match_parent" android:layout_height="match_parent"/>
    </android.support.v7.widget.CardView>
    <ImageButton android:id="@+id/imageButtonInfo1" android:layout_width="48dp" android:layout_height="48dp" android:visibility="gone"/>
    <ImageButton android:id="@+id/imageButtonRateUs" android:layout_width="48dp" android:layout_height="48dp" android:visibility="gone"/>
   </LinearLayout>
  </LinearLayout>
 </ScrollView>
 <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:paddingLeft="24dp" android:paddingRight="24dp" android:paddingTop="12dp" android:paddingBottom="16dp" android:background="@color/canvas">
  <Button android:id="@+id/buttonNavigation" style="@style/Cek.Button.Primary" android:text="Petunjuk arah  →" />
 </LinearLayout>
</LinearLayout>
