<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" android:layout_width="match_parent" android:layout_height="match_parent" android:fillViewport="true" android:background="@color/canvas">
 <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="24dp">
  <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="DARI KAMU, UNTUK PENJELAJAH LAIN" android:textSize="10sp" android:textColor="@color/colorPrimary" android:fontFamily="sans-serif" android:textStyle="bold" android:letterSpacing="0.16" /><TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Tempat baik&#10;layak dibagikan." android:textSize="30sp" android:textColor="@color/ink" android:fontFamily="sans-serif" android:textStyle="bold" android:layout_marginTop="12dp"/><TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Bantu orang lain menemukan tempat yang kamu kenal." android:textSize="14sp" android:textColor="@color/muted" android:fontFamily="sans-serif" android:lineSpacingExtra="4dp" android:layout_marginTop="10dp" android:layout_marginBottom="28dp"/>
  <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="01 / KENALI TEMPATNYA" android:textSize="10sp" android:textColor="@color/colorPrimary" android:fontFamily="sans-serif" android:textStyle="bold" android:letterSpacing="0.16" /><TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Nama tempat" android:textSize="13sp" android:textColor="@color/ink" android:fontFamily="sans-serif" android:layout_marginTop="16dp" android:textStyle="bold"/><EditText android:id="@+id/etNamaTempat" style="@style/Cek.Field" android:hint="Contoh: Taman Kota" android:inputType="textCapSentences" />
  <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Kategori" android:textSize="13sp" android:textColor="@color/ink" android:fontFamily="sans-serif" android:textStyle="bold"/>
  <FrameLayout android:layout_width="match_parent" android:layout_height="56dp" android:layout_marginTop="8dp" android:layout_marginBottom="20dp" android:background="@drawable/bg_field"><Spinner android:id="@+id/spinner" android:layout_width="match_parent" android:layout_height="match_parent" android:background="@android:color/transparent" android:paddingLeft="16dp" android:paddingRight="40dp" android:entries="@array/kategori"/><ImageView android:layout_width="18dp" android:layout_height="18dp" android:layout_gravity="right|center_vertical" android:layout_marginRight="16dp" android:rotation="90" android:src="@drawable/ic_ui_arrow" android:importantForAccessibility="no"/></FrameLayout>
  <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Tentang tempat ini" android:textSize="13sp" android:textColor="@color/ink" android:fontFamily="sans-serif" android:textStyle="bold"/><EditText android:id="@+id/etdeskripsi" style="@style/Cek.Field" android:hint="Apa yang membuat tempat ini menarik?" android:inputType="textMultiLine" android:minLines="3" android:singleLine="false" android:gravity="top" android:paddingTop="16dp" android:layout_height="112dp"/>
  <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="02 / LOKASI &amp; KONTAK" android:textSize="10sp" android:textColor="@color/colorPrimary" android:fontFamily="sans-serif" android:textStyle="bold" android:letterSpacing="0.16" android:layout_marginTop="12dp"/>
  <Button android:id="@+id/pilihalamat" style="@style/Cek.Button.Secondary" android:text="Pilih lokasi di peta" android:layout_marginTop="16dp" android:onClick="openMaps"/>
  <EditText android:id="@+id/etSetLokasi" style="@style/Cek.Field" android:hint="Alamat akan muncul setelah dipilih" android:inputType="textPostalAddress" android:enabled="false"/>
  <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Nomor telepon" android:textSize="13sp" android:textColor="@color/ink" android:fontFamily="sans-serif" android:textStyle="bold"/><EditText android:id="@+id/etPhone" style="@style/Cek.Field" android:hint="Nomor yang dapat dihubungi" android:inputType="phone" />
  <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="03 / TAMBAHKAN FOTO" android:textSize="10sp" android:textColor="@color/colorPrimary" android:fontFamily="sans-serif" android:textStyle="bold" android:letterSpacing="0.16" android:layout_marginTop="12dp"/>
  <ImageView android:id="@+id/iv_camera" android:layout_width="match_parent" android:layout_height="164dp" android:layout_marginTop="16dp" android:background="@drawable/bg_photo" android:src="@drawable/ic_ui_photo" android:scaleType="centerInside" android:padding="50dp" android:contentDescription="Preview foto tempat" android:clipToOutline="true"/>
  <Button android:id="@+id/selectImage" style="@style/Cek.Button.Secondary" android:text="Pilih foto tempat" android:layout_marginTop="12dp" android:onClick="selectImage"/>
  <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Gunakan foto yang menggambarkan tempat dengan jelas." android:textSize="12sp" android:textColor="@color/muted" android:fontFamily="sans-serif" android:lineSpacingExtra="3dp" android:layout_marginTop="12dp" android:layout_marginBottom="24dp"/>
  <Button android:id="@+id/bt_camera" style="@style/Cek.Button.Primary" android:text="Kirim usulan tempat" android:onClick="uploadImage"/>
  <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Usulanmu masuk ke daftar peninjauan sebelum ditampilkan." android:textSize="12sp" android:textColor="@color/muted" android:fontFamily="sans-serif" android:gravity="center" android:lineSpacingExtra="3dp" android:layout_marginTop="14dp" android:layout_marginBottom="12dp"/>
 </LinearLayout>
</ScrollView>
