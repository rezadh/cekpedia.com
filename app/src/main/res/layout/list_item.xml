<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:background="@drawable/bg_card" android:padding="12dp">
 <android.support.v7.widget.CardView android:layout_width="match_parent" android:layout_height="156dp" app:cardCornerRadius="22dp" app:cardElevation="0dp" app:cardPreventCornerOverlap="false"><FrameLayout android:layout_width="match_parent" android:layout_height="match_parent">
  <ImageView android:id="@+id/imgview" android:background="@color/mint" android:layout_width="match_parent" android:layout_height="match_parent" android:scaleType="centerCrop" android:contentDescription="Foto tempat"/>
  <TextView android:id="@+id/tvsponsor" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_gravity="top|right" android:layout_margin="10dp" android:background="@drawable/bg_badge" android:padding="8dp" android:text="Pilihan mitra" android:textColor="@color/colorPrimary" android:textSize="10sp" android:fontFamily="sans-serif-medium" android:visibility="gone"/>
 </FrameLayout></android.support.v7.widget.CardView>
