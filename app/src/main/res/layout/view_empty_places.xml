<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:background="@drawable/bg_mint" android:padding="24dp">
 <ImageView android:layout_width="40dp" android:layout_height="40dp" android:src="@drawable/ic_ui_pin"/>
 <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Masih ada yang bisa ditemukan." android:textSize="21sp" android:textColor="@color/ink" android:fontFamily="sans-serif" android:id="@+id/empty_places_title" android:textStyle="bold" android:layout_marginTop="18dp"/>
 <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Belum ada tempat untuk ditampilkan. Coba pencarian lain atau jelajahi kategori berikutnya." android:textSize="14sp" android:textColor="@color/muted" android:fontFamily="sans-serif" android:id="@+id/empty_places_message" android:lineSpacingExtra="5dp" android:layout_marginTop="10dp"/>
<Button android:id="@+id/retry_places" style="@style/Cek.Button.Secondary" android:text="Muat ulang" android:visibility="gone" android:layout_marginTop="18dp"/>
</LinearLayout>
